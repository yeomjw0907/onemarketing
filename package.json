{
  "name": "onemarketing",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "clip-lab": "node scripts/clip-lab/server.mjs",
    "clip-lab:batch": "node scripts/clip-lab/batch.mjs",
    "clip-lab:research": "node scripts/clip-lab/research.mjs",
    "clip-lab:research:group": "node scripts/clip-lab/research-group.mjs",
    "clip-lab:research:fal": "node scripts/clip-lab/fal-research.mjs",
    "clip-lab:collect": "node scripts/clip-lab/collect.mjs",
    "clip-lab:catalog": "node scripts/clip-lab/catalog.mjs",
    "clip-lab:storyboard": "node scripts/clip-lab/storyboard.mjs",
    "clip-lab:master": "node scripts/clip-lab/master-audio.mjs",
    "clip-lab:test": "node --test tests/clip-lab*.test.mjs tests/gemini-video-smoke.test.mjs",
    "assistant:pair": "tsx scripts/assistant-pc.ts pair",
    "assistant:worker": "tsx scripts/assistant-pc.ts worker",
    "assistant:startup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/assistant-startup.ps1 -Mode Install",
    "assistant:startup:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/assistant-startup.ps1 -Mode Status",
    "assistant:startup:disable": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/assistant-startup.ps1 -Mode Disable",
    "test": "tsx --test tests/*.test.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "worker": "tsx scripts/worker.ts",
    "setup-admins": "tsx scripts/setup-admins.ts",
    "format": "prettier --write src scripts tests supabase next.config.ts tsconfig.json package.json vercel.json",
    "format:check": "prettier --check src scripts tests supabase next.config.ts tsconfig.json package.json vercel.json",
    "smoke": "tsx scripts/smoke-http.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:import-sqlite": "tsx scripts/migrate-sqlite-to-supabase.ts",
    "acceptance": "tsx scripts/acceptance-server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeomjw0907/onemarketing.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/yeomjw0907/onemarketing/issues"
  },
  "homepage": "https://github.com/yeomjw0907/onemarketing#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/canvas": "0.1.80",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.117.3",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.7",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.57.0",
    "next": "^16.4.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "2.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "thinking-orbs": "^0.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@openai/codex": "^0.163.0",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "hyperframes": "0.9.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "overrides": {
    "uuid": "^11.1.1"
  },
  "type": "module"
}
