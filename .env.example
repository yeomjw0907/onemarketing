# Copy this file to .env.local. Never commit real keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
FAL_KEY=
FAL_IMAGE_MODEL=openai/gpt-image-2.5/sunburst/edit
FAL_VIDEO_MODEL=bytedance/seedance-2.5/image-to-video
# Scrypt hashes only; initialize through npm run setup-admins.
ADMIN_USERS_JSON=[]
APP_URL=http://localhost:3000
COOKIE_SECURE=false
FFMPEG_PATH=ffmpeg

# Supabase PostgreSQL (server only). Use the Supabase connection string (session pooler, port 5432 recommended).
DATABASE_URL=
# Optional: schema for isolated test/acceptance data. Production uses public.
# DB_SCHEMA=public
# Supabase Storage (private bucket). Service role key is server-only; never expose to the browser.
SUPABASE_URL=https://jyleynqxweqccptukvkn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=onemarketing-assets

# Job runner. Serverless ticks (after + cron + chained /api/jobs/run) need CRON_SECRET and APP_URL.
# Set JOB_RUNNER=worker to disable serverless ticks and rely on `npm run worker` only.
CRON_SECRET=
# JOB_RUNNER=serverless

# Legacy SQLite data directory, only used by scripts/migrate-sqlite-to-supabase.ts
DATA_DIR=.data

# Required only for Anthropic keys not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
